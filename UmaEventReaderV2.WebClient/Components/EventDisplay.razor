@using UmaEventReaderV2.Models.Entities
@using UmaEventReaderV2.Models.Enums
@inherits ComponentBase

<MudCard Class="mb-3" Style="border: 1px solid lightgrey">
    <MudCardHeader Class="pa-2">
        <MudText Typo="Typo.h6">@Event.EventName - @Event.CharacterName</MudText>
    </MudCardHeader>
    <MudCardContent Class="pr-2 pl-2 pt-0 pb-2">
        <MudStack>
        @foreach (var choiceGroup in GetGroupedChoices())
        {
            var choice = choiceGroup.Key;
            <MudText Typo="Typo.subtitle1">
                @choice.ChoiceNumber - @choice.ChoiceText
            </MudText>

            @foreach (var outcomeGroup in choiceGroup.Value)
            {
                var successType = outcomeGroup.Key;
                <MudText Typo="Typo.body2" Class="ml-2">@successType</MudText>

                <MudPaper Class="pa-2 mb-2 ml-4" Elevation="1">
                    @foreach (var outcome in outcomeGroup.Value)
                    {
                        <EventOutcome Outcome="@outcome"/>
                    }
                </MudPaper>
            }
        }
        </MudStack>
    </MudCardContent>
</MudCard>


@code {
    [Parameter] public UmaEventEntity Event { get; set; } = new();

    private Dictionary<(int ChoiceNumber, string ChoiceText), Dictionary<SuccessType, List<UmaEventChoiceOutcomeEntity>>> GetGroupedChoices()
    {
        return Event.Choices.Values
            .GroupBy(c => (c.ChoiceNumber, c.ChoiceText))
            .ToDictionary(
                g => g.Key,
                g => g.GroupBy(c => c.SuccessType)
                    .ToDictionary(
                        sg => sg.Key,
                        sg => sg.SelectMany(c => c.Outcomes.Values).ToList()
                    )
            );
    }

}