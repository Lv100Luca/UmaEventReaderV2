@using UmaEventReaderV2.Models.Entities
@using UmaEventReaderV2.Models.Enums
@inherits ComponentBase

<MudCard Elevation="0" Class="mb-3" Style="border: 2px solid lightgrey">
    <MudCardHeader Class="pa-2">
        <MudText Typo="Typo.h6">@Event.Name - @Event.CharacterName</MudText>
    </MudCardHeader>

    <MudCardContent Class="pr-2 pl-2 pt-0 pb-2">
        <MudStack Spacing="0">
            @foreach (var choice in Event.Choices)
            {
                <MudCard Elevation="0" Class="mb-3" Style="border: 2px solid lightgrey">
                    <MudCardHeader Class="pa-2">
                        <MudText Typo="Typo.subtitle1">
                            #@choice.Header.Number - @choice.Header.Text
                        </MudText>
                    </MudCardHeader>

                    <MudCardContent Class="pa-2">
                        <MudStack Spacing="2">
                            @foreach (var (successType, umaEventChoiceOutcomes) in choice.Outcomes.OrderBy(x => x.Key))
                            {
                                <div class="success-type">
                                    <MudText Typo="Typo.body2"
                                             Class="ml-2 mb-1">
                                        <b>@successType</b>
                                    </MudText>

                                    <MudStack Row Spacing="1">
                                        @foreach (var outcome in umaEventChoiceOutcomes)
                                        {
                                            <EventOutcome Outcome="@outcome"/>
                                        }
                                    </MudStack>
                                </div>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }

        </MudStack>
    </MudCardContent>
</MudCard>



