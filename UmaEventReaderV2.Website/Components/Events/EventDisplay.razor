@inherits ComponentBase

<MudCard Elevation="0" Class="mb-3" Style="border: 2px solid lightgrey">
    <MudCardHeader Class="pa-2">
        <MudStack Style="width: 100%" Row Justify="Justify.SpaceBetween">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">
                    @Event.Name
                </MudText>
                <MudText Typo="Typo.body1">
                    @foreach (var uma in @Event.Umas)
                    {
                        <span>@uma.FullName</span>
                    }
                </MudText>
            </MudStack>
            <MudSpacer/>
            <UmaDisplay Uma="@(Event.Umas.First())" Size="64"></UmaDisplay>
        </MudStack>
    </MudCardHeader>

    <MudCardContent Class="pr-2 pl-2 pt-0 pb-2">
        <MudStack Spacing="0">
            @foreach (var choice in Event.Choices)
            {
                <EventChoice Choice="choice"></EventChoice>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public required UmaEvent Event { get; set; }
}