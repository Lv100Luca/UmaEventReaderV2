@using System.Drawing
@using Color = MudBlazor.Color

@inject WebSettingsHub WebSettingsHub
<MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">@Title</MudText>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   OnClick="HandleSelectAreaClicked"
                   Disabled="Disabled">
            Select New Area
        </MudButton>
    </MudStack>

    <MudPaper Class="pa-4 mt-2" Elevation="1" Outlined="true">
        <MudGrid>
            <MudItem xs="12">

                <MudSelect T="ScreenResolutions" xs="12" ValueChanged="OnPresetSelected" Label="Screen Preset" Variant="Variant.Outlined"
                           Dense="true">
                    @foreach (var preset in Enum.GetValues<ScreenResolutions>())
                    {
                        <MudSelectItem Value="preset"
                                       Disabled="@(preset != ScreenResolutions.R1440p_16_9 && preset != ScreenResolutions.Unknown)">
                            @preset.ToDisplayString()
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="6">
                <MudNumericField @bind-Value="X"
                                 Label="X"
                                 Variant="Variant.Outlined"
                                 Min="0"/>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="Y"
                                 Label="Y"
                                 Variant="Variant.Outlined"
                                 Min="0"/>
            </MudItem>

            <MudItem xs="6">
                <MudNumericField @bind-Value="Width"
                                 Label="Width"
                                 Variant="Variant.Outlined"
                                 Min="0"/>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="Height"
                                 Label="Height"
                                 Variant="Variant.Outlined"
                                 Min="0"/>
            </MudItem>
        </MudGrid>

        <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2">
            <MudStack Row>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           OnClick="OnShowPreview"
                >
                    Get Preview
                </MudButton>
                <MudToggleIconButton
                    @bind-Toggled="ShowPreview"
                    Icon="@Icons.Material.Filled.Search"
                    Color="Color.Primary"
                    ToggledIcon="@Icons.Material.Filled.SearchOff"
                    ToggledColor="Color.Error"
                    Variant="Variant.Outlined"
                    Disabled="@(ScreenshotData is null)"
                />
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       OnClick="ClearArea"
            >
                Clear
            </MudButton>

        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrEmpty(ScreenshotData) && ShowPreview)
    {
        <MudPaper Class="pa-2" Elevation="1" Style="display: flex; justify-content: center;">
            <MudImage Src="@($"data:image/png;base64,{ScreenshotData}")" Alt="Screenshot"
                      Style="max-width:100%; border-radius: 4px;"
                      ObjectFit="ObjectFit.Contain"/>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public string Title { get; set; } = "Event Area";

    [Parameter] public Rectangle? Area { get; set; }
    [Parameter] public EventCallback<Rectangle?> AreaChanged { get; set; }

    [Parameter] public EventCallback OnSelectArea { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private ScreenResolutions SelectedPreset { get; set; }

    private int X
    {
        get => Area?.X ?? 0;
        set => UpdateArea(x: value);
    }

    private int Y
    {
        get => Area?.Y ?? 0;
        set => UpdateArea(y: value);
    }

    private int Width
    {
        get => Area?.Width ?? 0;
        set => UpdateArea(width: value);
    }

    private int Height
    {
        get => Area?.Height ?? 0;
        set => UpdateArea(height: value);
    }

    public string? ScreenshotData { get; set; }

    private void UpdateArea(int? x = null, int? y = null, int? width = null, int? height = null)
    {
        var current = Area ?? new Rectangle();

        Area = new Rectangle(
            x ?? current.X,
            y ?? current.Y,
            width ?? current.Width,
            height ?? current.Height
        );

        AreaChanged.InvokeAsync(Area);
    }

    private async Task HandleSelectAreaClicked()
    {
        if (OnSelectArea.HasDelegate)
            await OnSelectArea.InvokeAsync();
    }

    private async Task ClearArea()
    {
        Area = null;
        ScreenshotData = null;
        await AreaChanged.InvokeAsync(Area);
    }

    private bool ShowPreview = false;

    private async Task OnShowPreview()
    {
        if (Area is not { } screenshotArea)
            return;

        ScreenshotData = await WebSettingsHub.CapturePreviewScreenshotAsync(screenshotArea);
        ShowPreview = true;
    }

    private void OnPresetSelected(ScreenResolutions selectedPreset)
    {
        SelectedPreset = selectedPreset;

        var area = selectedPreset.GetPresetArea();

        UpdateArea(area.X,area.Y, area.Width, area.Height);
    }
}
