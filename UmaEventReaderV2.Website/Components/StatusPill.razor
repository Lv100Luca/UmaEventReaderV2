@inject ConnectionStatusHub StatusHub

<MudTooltip Text="@TooltipText">
    <MudChip T="string"
             Color="@ChipColor"
             Variant="Variant.Outlined"
             Size="Size.Large">
        <div class="status-pill">
            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"/>
            @StatusText
        </div>
    </MudChip>
</MudTooltip>

@code {
    private HubConnectionState Status { get; set; }

    private string StatusText => Status switch
    {
        HubConnectionState.Disconnected => "Disconnected",
        HubConnectionState.Connecting => "Connecting...",
        HubConnectionState.Reconnecting => "Reconnecting...",
        HubConnectionState.Connected => "Connected",
        _ => "Unknown"
    };

    private string TooltipText => Status switch
    {
        HubConnectionState.Disconnected => "No connection to backend",
        HubConnectionState.Connecting => "Connecting to backend...",
        HubConnectionState.Reconnecting => "Re-establishing connection...",
        HubConnectionState.Connected => "Connected to backend",
        _ => "Unknown state"
    };

    private Color ChipColor
    {
        get
        {
            if (Status == HubConnectionState.Connected && !IsAlive)
                return Color.Warning;

            return Status switch
            {
                HubConnectionState.Disconnected => Color.Error,
                HubConnectionState.Connecting => Color.Info,
                HubConnectionState.Reconnecting => Color.Info,
                HubConnectionState.Connected => Color.Success,
                _ => Color.Default
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var a = await StatusHub.PingAsync();

        Console.Out.WriteLine(a);

        var cts = new CancellationTokenSource();

        await MonitorPingAsync(cts.Token);
    }

    public bool IsAlive { get; set; }

    public async Task MonitorPingAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                Status = StatusHub.Connection.State;

                if (Status == HubConnectionState.Connected)
                    IsAlive = await StatusHub.PingAsync();

                StateHasChanged();

                await Task.Delay(TimeSpan.FromSeconds(1), token);
            }
        }
        catch (Exception e)
        {
            Status = HubConnectionState.Disconnected;
            IsAlive = false;
            StateHasChanged();
        }
    }
}

