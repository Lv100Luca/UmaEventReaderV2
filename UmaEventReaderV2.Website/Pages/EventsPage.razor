@page "/"
@using UmaEventReaderV2.Common.Models.dto
@inject UmaEventHub EventHub
@inject WebSettingsHub SettingsHub

<MudStack Spacing="2">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Events (@events.Count - Results)</MudText>
        @if (Settings?.CareerCharacterOverride is { } uma)
        {
            <UmaDisplay Uma="uma" IncludeName/>
        }
        else
        {
            <MudText>No Trainee Selected</MudText>
        }
    </MudStack>
    <div class="dashboard-container">
        @if (events.Any())
        {
            <div class="events-panel">
                @foreach (var e in events)
                {
                    <EventDisplay Event="e"/>
                }
            </div>
        }
    </div>
</MudStack>

@code {
    private List<UmaEvent> events = [];

    public required SettingsDto? Settings { get; set; }

    protected override async Task OnInitializedAsync()
    {
        EventHub.OnEventFound += HandleEventsFound;

        Settings = await SettingsHub.GetSettingsAsync();

        await EventHub.StartHubIfDisconnected();
    }

    private void HandleEventsFound(EventBatch batch)
    {
        if (events.Count == batch.Events.Count() &&
            events
                .Zip(batch.Events, (a, b) => a.Name == b.Name)
                .All(x => x))
            return;

        events = batch.Events.ToList();
        InvokeAsync(StateHasChanged);
    }
}