@page "/"
@using System.Collections.ObjectModel
@inject UmaEventHub EventHub

<h1>UmaEventReader Dashboard</h1>
<div class="dashboard-container">
    <div class="events-panel">
        @foreach (var e in events)
        {
            <EventDisplay Event="e"/>
        }
    </div>
</div>

@code {
    // private ObservableCollection<string> logMessages = new();
    private readonly ObservableCollection<UmaEvent> events = [];

    protected override async Task OnInitializedAsync()
    {
        // HubConnection.On<string>("OnLog", msg =>
        // {
        // logMessages.Add(msg);
        // InvokeAsync(StateHasChanged);
        // });

        EventHub.Connection.On<EventBatch>("OnEventFound", batch =>
        {
            events.Clear();

            foreach (var e in batch.Events)
                events.Add(e);

            InvokeAsync(StateHasChanged);
        });

        if (EventHub.Connection.State == HubConnectionState.Disconnected)
        {
            await EventHub.Connection.StartAsync();
        }
    }
}