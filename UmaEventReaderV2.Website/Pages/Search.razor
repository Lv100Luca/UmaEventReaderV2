@page "/Search"
@using System.Collections.ObjectModel

@inject NavigationManager NavigationManager
@inject UmaEventHub Hub

<MudStack>
    <MudText Typo="Typo.h4"> Search (@umaEvents.Count - Results)</MudText>
    @foreach (var umaEvent in umaEvents)
    {
        <EventDisplay Event="umaEvent"></EventDisplay>
    }
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "query")]
    public string? SearchQuery { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery) || SearchQuery.Length < 3)
            return;

        var searchModel = new EventSearchModel
        {
            Name = SearchQuery
        };

        umaEvents.Fill(await Hub.InvokeSearchAsync(searchModel));
    }

    private readonly ObservableCollection<UmaEvent> umaEvents = [];
}