@page "/Search"
@using System.Collections.ObjectModel
@using UmaEventReaderV2.Models
@using UmaEventReaderV2.Models.Entities
@using UmaEventReaderV2.WebClient.Extensions

@inject UmaEventHub Hub

<MudStack>
    <MudTextField T="string" Variant="Variant.Outlined" Placeholder="Search Event" ValueChanged="@Callback"/>
    <MudStack>
        @foreach (var umaEvent in umaEvents)
        {
            <EventDisplay Event="umaEvent"></EventDisplay>
        }
    </MudStack>
</MudStack>

@code {
    private readonly ObservableCollection<UmaEvent> umaEvents = [];

    private async Task Callback(string searchText)
    {
        var searchModel = new EventSearchModel
        {
            Name = searchText
        };

        umaEvents.Fill(await Hub.InvokeSearchAsync(searchModel));
    }
}