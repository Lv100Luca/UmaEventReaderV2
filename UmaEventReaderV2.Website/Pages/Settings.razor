@page "/settings"
@using System.Drawing
@using Color = MudBlazor.Color
@inject WebUmaHub UmaHub
@inject WebSettingsHub SettingsHub
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h5">Application Settings</MudText>
    <MudDivider Class="my-2"/>

    <MudStack Spacing="2">
        <MudNumericField @bind-Value="ScanMillies"
                         Label="Scan Interval (ms)"
                         Min="50"
                         Max="5000"
                         Step="50"
                         Variant="Variant.Outlined"
                         Immediate="true"/>

        <MudAutocomplete T="Uma"
                         @bind-Value="FilteredUma"
                         Label="Career Character Override"
                         Variant="Variant.Outlined"
                         ToStringFunc="@(uma => uma?.FullName)"
                         SearchFunc="SearchUmas"
                         Clearable="true"
                         Dense="true"
                         CoerceText="true"
                         ResetValueOnEmptyText="true">
            <ItemTemplate Context="uma">
                <UmaDisplay Uma="uma" IncludeName/>
            </ItemTemplate>
        </MudAutocomplete>

        <MudDivider Class="my-2"/>

        <SettingsEventArea Title="Event Area"
                           @bind-Area="EventArea"
                           OnSelectArea="SelectNewArea"
        />

        <MudStack AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween" Row>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       OnClick="ClearArea"
                       Disabled="@(!Dirty)">
                Clear
            </MudButton>

            <MudBadge Overlap
                      Visible="Dirty"
                      Color="Color.Warning"
                      Icon="@Icons.Material.Filled.Warning">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="SaveSettings">
                    Save Settings
                </MudButton>
            </MudBadge>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    private UmaEventReaderSettings settings = new();
    private IEnumerable<Uma> umas = [];

    private int ScanMillies
    {
        get => (int)settings.ScanInterval.TotalMilliseconds;
        set
        {
            MakeDirty();

            settings.ScanInterval = TimeSpan.FromMilliseconds(value);
        }
    }

    private Uma? FilteredUma
    {
        get => settings.FilteredCharacter;
        set
        {
            MakeDirty();
            settings.FilteredCharacter = value;
        }
    }

    private Rectangle? EventArea
    {
        get => settings.EventArea;
        set
        {
            MakeDirty();

            settings.EventArea = value;
        }
    }

    public bool Dirty { get; set; }

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsHub.GetSettingsAsync();
        umas = await UmaHub.GetUmas();

        Initialized = true;
    }

    private async Task SaveSettings()
    {
        await SettingsHub.SaveSettingsAsync(settings);
        Snackbar.Add("Settings saved successfully.", Severity.Success);

        Dirty = false;
    }

    private async Task<IEnumerable<Uma>> SearchUmas(string? name, CancellationToken cancellation)
    {
        if (string.IsNullOrWhiteSpace(name))
            return umas;

        return umas.Where(u => u.FullName.Contains(name, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SelectNewArea()
    {
        var rect = await SettingsHub.SelectNewAreaAsync();

        if (rect is null)
        {
            Snackbar.Add("Error selecting area.", Severity.Error);

            return;
        }

        Snackbar.Add("Area selected successfully.", Severity.Success);

        settings.EventArea = rect;
    }

    private async Task ClearArea(MouseEventArgs arg)
    {
        settings = await SettingsHub.GetSettingsAsync();

        Snackbar.Add("Settings cleared", Severity.Success);

        Dirty = false;
    }

    private void MakeDirty()
    {
        if (Initialized)
        {
            StateHasChanged();
            Dirty = true;
            Console.Out.WriteLine("Dirty");
        }
    }

    public bool Initialized { get; set; } = false;
}
